# Copy this file to .env.local and fill in your own values.
# .env.local is never committed.

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# The single demo account that can open a settings screen, such as
# /veluwse-hei/settings. Kept simple on purpose; this is a local demo.
DEMO_EMAIL=admin@test.nl
DEMO_PASSWORD=admin
